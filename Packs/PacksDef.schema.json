{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Azure Monitor Starter Packs Definition",
    "description": "Schema for PacksDef.json - defines monitoring packs with their rules, alerts, discovery queries, and dashboards.",
    "type": "object",
    "required": ["Packs"],
    "additionalProperties": false,
    "properties": {
        "Packs": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/Pack"
            }
        }
    },
    "definitions": {
        "Pack": {
            "type": "object",
            "required": ["Name", "Tag", "Description", "OS", "Rules", "Alerts"],
            "additionalProperties": false,
            "properties": {
                "Name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Display name of the monitoring pack."
                },
                "Tag": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9_-]+$",
                    "description": "Unique identifier tag for the pack. Alphanumeric, hyphens, and underscores only."
                },
                "Description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Description of what the pack monitors."
                },
                "OS": {
                    "type": "string",
                    "enum": ["Windows", "Linux", "All"],
                    "description": "Target operating system."
                },
                "Rules": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/Rule"
                    }
                },
                "Alerts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Alert"
                    }
                },
                "Discovery": {
                    "$ref": "#/definitions/Discovery"
                },
                "Dashboards": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Dashboard"
                    }
                },
                "Agents": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Agent"
                    }
                }
            }
        },
        "Rule": {
            "type": "object",
            "required": ["Rulename", "RuleType", "RuleNamePath"],
            "additionalProperties": false,
            "properties": {
                "Rulename": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unique name for the rule within this pack."
                },
                "RuleType": {
                    "type": "string",
                    "enum": ["EventPerformance", "CustomData", "IISLogs", "syslog", "VMInsights", "ServiceMap"],
                    "description": "Type of data collection rule."
                },
                "RuleNamePath": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\.bicep$",
                    "description": "Path to the Bicep DCR template file."
                },
                "xPathQueries": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Windows Event Log XPath queries for EventPerformance rules."
                },
                "performanceCounters": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Performance counter paths for EventPerformance rules."
                },
                "filepatterns": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "File patterns for CustomData rules."
                },
                "fileCollection": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "File collection paths."
                },
                "tableName": {
                    "type": "string",
                    "description": "Custom Log Analytics table name for CustomData rules."
                },
                "createTable": {
                    "type": "boolean",
                    "description": "Whether to create the custom table."
                },
                "kqlTransformation": {
                    "type": "string",
                    "description": "KQL transformation query for data ingestion."
                },
                "facilitynames": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Syslog facility names for syslog rules."
                },
                "logLevels": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Syslog log levels for syslog rules."
                },
                "syslogDataSourceName": {
                    "type": "string",
                    "description": "Syslog data source name."
                },
                "clientAppName": {
                    "type": "string",
                    "description": "VM application name for CustomData rules."
                },
                "clientAppDescription": {
                    "type": "string",
                    "description": "VM application description."
                },
                "clientAppVersion": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                    "description": "Semantic version of the client application."
                },
                "clientAppInstallCommand": {
                    "type": "string",
                    "description": "Command to install the VM application."
                },
                "clientAppUninstallCommand": {
                    "type": "string",
                    "description": "Command to uninstall the VM application."
                },
                "clientAppZIPFile": {
                    "type": "string",
                    "description": "ZIP file name for the client application package."
                }
            }
        },
        "Alert": {
            "type": "object",
            "required": ["alertRuleDescription", "alertRuleDisplayName", "alertRuleName", "alertRuleSeverity", "alertType", "query"],
            "additionalProperties": false,
            "properties": {
                "alertRuleDescription": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Description of the alert rule."
                },
                "alertRuleDisplayName": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Display name of the alert rule."
                },
                "alertRuleName": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9_()\\-]+$",
                },
                "alertRuleSeverity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4,
                    "description": "Alert severity (0=Critical, 1=Error, 2=Warning, 3=Informational, 4=Verbose)."
                },
                "autoMitigate": {
                    "type": "boolean",
                    "description": "Whether the alert auto-resolves."
                },
                "evaluationFrequency": {
                    "type": "string",
                    "pattern": "^PT[0-9]+[MH]$",
                    "description": "How often the alert is evaluated (ISO 8601 duration, e.g., PT5M, PT15M)."
                },
                "windowSize": {
                    "type": "string",
                    "pattern": "^PT[0-9]+[MH]$",
                    "description": "Time window for alert evaluation (ISO 8601 duration, e.g., PT15M)."
                },
                "alertType": {
                    "type": "string",
                    "enum": ["rows", "Aggregated"],
                    "description": "Type of alert query - 'rows' for row-count or 'Aggregated' for metric measurement."
                },
                "query": {
                    "type": "string",
                    "minLength": 1,
                    "description": "KQL query for the alert rule."
                },
                "metricMeasureColumn": {
                    "type": "string",
                    "description": "Column name for metric measurement (required for Aggregated alerts)."
                },
                "operator": {
                    "type": "string",
                    "enum": ["GreaterThan", "GreaterThanOrEqual", "LessThan", "LessThanOrEqual", "Equal"],
                    "description": "Comparison operator for Aggregated alerts."
                },
                "threshold": {
                    "type": "number",
                    "description": "Threshold value for Aggregated alerts."
                }
            }
        },
        "Discovery": {
            "type": "object",
            "required": ["Query"],
            "additionalProperties": false,
            "properties": {
                "Query": {
                    "type": "string",
                    "minLength": 1,
                    "description": "KQL query to discover resources that should use this pack."
                }
            }
        },
        "Dashboard": {
            "type": "object",
            "required": ["Name", "Description", "DashboardPath"],
            "additionalProperties": false,
            "properties": {
                "Name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Dashboard name."
                },
                "Description": {
                    "type": "string",
                    "description": "Dashboard description."
                },
                "DashboardPath": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Path to the Grafana dashboard JSON file."
                }
            }
        },
        "Agent": {
            "type": "object",
            "properties": {
                "Name": {
                    "type": "string",
                    "description": "Agent name."
                },
                "Type": {
                    "type": "string",
                    "description": "Agent type."
                }
            }
        }
    }
}
