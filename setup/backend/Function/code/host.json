{
    "version": "2.0",
    "functionTimeout": "00:10:00",
    "managedDependency": {
      "Enabled": true
    },
    "extensions": {
      "queues": {
        "maxDequeueCount": 3,
        "visibilityTimeout": "00:01:30",
        "messageEncoding": "none"
      }
    },
    "extensionBundle": {
      "id": "Microsoft.Azure.Functions.ExtensionBundle",
      "version": "[4.*, 5.0.0)"
    },
    "logging": {
      "logLevel": {
        "Azure.Core": "Warning",
        "Azure.Storage": "Warning",
        "Azure.Storage.Blobs": "Warning",
        "Azure.Storage.Queues": "Warning",
        "Microsoft.Azure.WebJobs.Host.Queues": "Warning",
        "Microsoft.Azure.WebJobs.Hosting": "Warning",
        "Microsoft.Azure.WebJobs.Script": "Warning",
        "Host.Singleton": "Warning"
      }
    }
  }